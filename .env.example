# ── Shared Auth0 config ────────────────────────────────────────────────────────
# Your Auth0 tenant domain (without https://)
AUTH0_DOMAIN=your-tenant.auth0.com

# The API Identifier (audience) for the MCP server — same value used in the
# MCP server's AUTH0_AUDIENCE env var
AUTH0_AUDIENCE=https://mcp.yourdomain.com/

# 32+ character random string for encrypting session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Full URL of this portal (no trailing slash)
APP_BASE_URL=https://mcp-demo-portal.vercel.app

# Full URL of the deployed MCP server (no trailing slash)
MCP_SERVER_BASE_URL=https://your-mcp-server.vercel.app

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Per-portal Auth0 Applications ─────────────────────────────────────────────
# Each portal uses a different Auth0 Application so Universal Login shows
# a distinct Page Template (logo, header, footer).
#
# In Auth0 Dashboard: Applications → Create Application → Regular Web App
# Set Allowed Callback URLs: ${APP_BASE_URL}/api/auth/<portal>/callback
# Set Allowed Logout URLs:   ${APP_BASE_URL}

BOOKKEEPER_CLIENT_ID=
BOOKKEEPER_CLIENT_SECRET=

AUTONAVIGATOR_CLIENT_ID=
AUTONAVIGATOR_CLIENT_SECRET=

PETADMIN_CLIENT_ID=
PETADMIN_CLIENT_SECRET=

DELEGATEDADMIN_CLIENT_ID=
DELEGATEDADMIN_CLIENT_SECRET=
