# ── Auth0 ──────────────────────────────────────────────────────────────────────
# Your Auth0 tenant domain (without https://)
AUTH0_DOMAIN=your-tenant.auth0.com

# Single Regular Web App client — all portals share one application.
# Branding per portal is driven by ext-brand= in the /authorize request,
# read inside the Universal Login Page Template as:
#   {{ transaction.params['ext-brand'] }}
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# The API Identifier (audience) for the MCP server
AUTH0_AUDIENCE=https://mcp.yourdomain.com/

# ── Session ────────────────────────────────────────────────────────────────────
# 32+ character random string for encrypting session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── URLs ───────────────────────────────────────────────────────────────────────
# Full URL of this portal (no trailing slash)
APP_BASE_URL=https://mcp-demo-portal.vercel.app

# Full URL of the deployed MCP server (no trailing slash)
MCP_SERVER_BASE_URL=https://your-mcp-server.vercel.app

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
